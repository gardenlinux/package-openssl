diff --git a/test/quic_stream_test.c b/test/quic_stream_test.c
index 6a646d9363..2493d3ff13 100644
--- a/test/quic_stream_test.c
+++ b/test/quic_stream_test.c
@@ -7,9 +7,42 @@
  * https://www.openssl.org/source/license.html
